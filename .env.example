# Copy to a private environment file or export these variables in your shell.
# Never paste real credentials into ChatGPT, commit them, or put them in .mcp.json.

# SoundCloud API application credentials. A registered application is required
# for live access; current SoundCloud guidance may require Artist Pro.
SOUNDCLOUD_CLIENT_ID=replace-with-your-client-id
SOUNDCLOUD_CLIENT_SECRET=replace-with-your-client-secret

# These defaults are the official hosts. Override only for a controlled test
# endpoint and keep the resulting hosts on the endpoint allowlist.
SOUNDCLOUD_API_BASE_URL=https://api.soundcloud.com
SOUNDCLOUD_AUTHORIZE_URL=https://secure.soundcloud.com/authorize
SOUNDCLOUD_TOKEN_URL=https://secure.soundcloud.com/oauth/token

# The API guide does not provide a universal scope list for this client.
# Leave empty unless SoundCloud gives your application a supported scope value.
SOUNDCLOUD_SCOPE=

# Exact callback used in the authorization request. It must match the app
# registration and callback request. Loopback is intended for local development.
LISTENING_COMPANION_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# The access/refresh token is session-only by default and is never written to
# this plugin or a plaintext token file. The preference database below stores
# only an explicitly consented preference_profile.
LISTENING_COMPANION_PREFERENCES_DB=

# Short-lived in-memory session settings.
LISTENING_COMPANION_CACHE_TTL_SECONDS=600
LISTENING_COMPANION_OAUTH_STATE_TTL_SECONDS=600
LISTENING_COMPANION_VIEWER_HOST=127.0.0.1
LISTENING_COMPANION_VIEWER_PORT=8765
